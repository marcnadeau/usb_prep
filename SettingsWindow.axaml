<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MediaFileAnalyzer.SettingsWindow"
        Title="Paramètres de préparation USB"
        Width="680"
        Height="700"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
  <Grid RowDefinitions="Auto,*,Auto" Margin="20">
    <StackPanel Grid.Row="0" Spacing="6">
      <TextBlock Text="Profil de copie et conversion"
                 FontSize="22"
                 FontWeight="Bold" />
      <TextBlock Text="Les formats cochés sont copiés sans modification. Les autres sont convertis directement vers l’USB ; les originaux sont conservés."
                 Foreground="#555"
                 TextWrapping="Wrap" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,16,0,16">
      <StackPanel Spacing="18">
        <StackPanel Spacing="8">
          <TextBlock Text="Formats à copier sans conversion"
                     FontWeight="SemiBold"
                     FontSize="15"
                     Foreground="#1F2933" />
          <TextBlock Text="Les formats décochés utilisent le profil ci-dessous. Si aucun format n’est coché, MP3 et M4A seront rétablis."
                     Foreground="#666"
                     TextWrapping="Wrap" />
          <StackPanel Name="KeepFormatsPanel" Spacing="6" />
        </StackPanel>

        <Border Background="#F6F7F8" Padding="14" CornerRadius="6">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
            <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                       Text="Format et codec de sortie"
                       FontWeight="SemiBold"
                       FontSize="15"
                       Foreground="#1F2933" />

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Format"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="#1F2933" />
            <ComboBox Grid.Row="1" Grid.Column="1"
                      Name="OutputFormatComboBox"
                      MinWidth="250"
                      SelectionChanged="OutputFormatComboBox_SelectionChanged" />

            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="Codec"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="#1F2933" />
            <ComboBox Grid.Row="2" Grid.Column="1"
                      Name="OutputCodecComboBox"
                      MinWidth="250" />
          </Grid>
        </Border>

        <Border Background="#F6F7F8" Padding="14" CornerRadius="6">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
            <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                       Text="Qualité"
                       FontWeight="SemiBold"
                       FontSize="15"
                       Foreground="#1F2933" />

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Débit (kbps)"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="#1F2933" />
            <TextBox Grid.Row="1" Grid.Column="1"
                     Name="BitrateTextBox"
                     Width="140"
                     HorizontalAlignment="Left"
                     PlaceholderText="320" />
          </Grid>
        </Border>

        <TextBlock Name="CodecAvailabilityText"
                   Foreground="#666"
                   TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="10">
      <Button Content="Annuler"
              Width="100"
              Click="CancelButton_Click" />
      <Button Content="Enregistrer"
              Width="100"
              Background="#1F7A8C"
              Foreground="White"
              Click="SaveButton_Click" />
    </StackPanel>
  </Grid>
</Window>
