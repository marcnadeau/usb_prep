<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
        xmlns:local="clr-namespace:MediaFileAnalyzer"
        x:Class="MediaFileAnalyzer.MainWindow"
        Title="USB Music Prep"
        Height="700"
        Width="1100"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ── Source row ── -->
    <Border Grid.Row="0" Padding="16,12" Background="#1b1b1b">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <TextBlock Grid.Column="0"
                   Text="1. Source :"
                   VerticalAlignment="Center"
                   FontWeight="Bold"
                   Margin="0,0,10,0" />

        <TextBox Grid.Column="1"
                 Name="FolderPathTextBox"
                 VerticalAlignment="Center"
                 Padding="8"
                 FontSize="14"
           Background="#222222"
           Foreground="White"
           BorderBrush="#2f2f2f"
                 PlaceholderText="Dossier de musique original (lecture seule pendant la préparation)…" />

          <Button Grid.Column="2"
          Name="BrowseSourceButton"
          Content="Choisir…"
          Click="BrowseButton_Click"
          Padding="15,8"
          Margin="10,0,0,0"
          FontSize="14"
          Background="#222222"
          Foreground="White"
          ToolTip.Tip="Choisir le dossier de musique source" />

        <Button Grid.Column="3"
          Content="Scan"
          IsVisible="False"
          Click="ScanButton_Click"
          Padding="15,8"
          Margin="10,0,0,0"
          FontSize="14"
          FontWeight="Bold"
          Background="#1DB954"
          Foreground="White"
          ToolTip.Tip="Scan selected source folder for audio files" />
      </Grid>
    </Border>

    <!-- ── Target row ── -->
    <Border Grid.Row="1" Padding="16,12" Background="#1b1b1b">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">
        <TextBlock Grid.Column="0"
                   Text="Destination USB :"
                   VerticalAlignment="Center"
                   FontWeight="Bold"
                   Margin="0,0,10,0" />

        <TextBox Grid.Column="1"
                 Name="TargetFolderPathTextBox"
                 VerticalAlignment="Center"
                 Padding="8"
                 FontSize="14"
                 IsReadOnly="True"
           Background="#222222"
           Foreground="White"
           BorderBrush="#2f2f2f"
                 PlaceholderText="Choisir le dossier de destination sur l’USB…" />

          <Button Grid.Column="2"
          Name="BrowseTargetButton"
          Content="Choisir…"
          Click="BrowseTargetButton_Click"
          Padding="15,8"
          Margin="10,0,0,0"
          FontSize="14"
          Background="#222222"
          Foreground="White"
          ToolTip.Tip="Choisir la destination USB" />

          <Button Grid.Column="3"
          Name="CompareButton"
          Content="Réanalyser"
          Click="CompareButton_Click"
          Padding="15,8"
          Margin="10,0,0,0"
          FontSize="14"
          FontWeight="Bold"
          Background="#1DB954"
          Foreground="White"
          IsEnabled="False"
          ToolTip.Tip="Actualiser l’analyse des deux dossiers sans écrire de fichiers" />

        <Button Grid.Column="4"
          Name="AdvancedButton"
          Content="Outils avancés ▾"
          Click="AdvancedButton_Click"
          Padding="12,8"
          Margin="20,0,0,0"
          FontSize="13"
          Background="#222222"
          Foreground="White"
          ToolTip.Tip="Actions avancées: Réorganiser, Nettoyer les doublons, Réparer USB" />
      </Grid>
    </Border>

    <!-- ── Actions toolbar ── -->
    <Border Grid.Row="2" Padding="16,10" Background="#1b1b1b">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center">
          <TextBlock Name="WorkflowSummaryText" TextWrapping="Wrap" Foreground="#DDDDDD" />
          <TextBlock Name="ProfileText" TextWrapping="Wrap" Foreground="#AAAAAA" FontSize="12" />
          <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Name="ConvertButton"
                  IsVisible="False"
                  Content="Convert FLAC to MP3 (320kbps)"
                  Padding="14,9"
                  FontSize="13"
                  FontWeight="Bold"
                  Background="#1DB954"
                  Foreground="White"
                  IsEnabled="False"
                  ToolTip.Tip="Convert FLAC files to the configured output format" />

              <Button Name="TransferButton"
              IsVisible="False"
              Content="Transfer to Target"
              Padding="14,9"
              FontSize="13"
              FontWeight="Bold"
              Background="#138a36"
              Foreground="White"
              IsEnabled="False"
              ToolTip.Tip="Copy or transcode missing tracks to the target" />

            <Button Name="PrepareUsbButton"
              Content="2. Analyser"
              Click="PrepareUsbButton_Click"
              Padding="14,9"
              FontSize="13"
              FontWeight="Bold"
              Background="#138a36"
              Foreground="White"
              IsEnabled="False"
              ToolTip.Tip="Analyser les deux dossiers, vérifier le résumé, puis préparer l’USB" />
            <CheckBox Name="UseSelectionCheckBox" Content="Limiter à la sélection du tableau" VerticalAlignment="Center" Foreground="#DDDDDD" />
          </StackPanel>

            <CheckBox Name="CompilationCheckBox"
                  IsVisible="False"
                  IsChecked="True"
                  VerticalAlignment="Center"
                  ToolTip.Tip="When checked, albums with multiple artists are grouped under a 'Various Artists' folder">
                <TextBlock Text="Conversion locale : regrouper les compilations sous « Various Artists »"
                     Foreground="#CCCCCC"
                     FontStyle="Italic" />
              </CheckBox>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Name="ProgressCountText"
                         Text=""
                         VerticalAlignment="Center"
                         Foreground="#CCCCCC"
                         FontWeight="Bold"
                         Margin="0,0,8,0" />

            <Button Name="SettingsButton"
              Content="⚙ Paramètres"
              Click="SettingsButton_Click"
              Padding="14,9"
              FontSize="13"
              FontWeight="Bold"
              Background="#222222"
              Foreground="White"
              ToolTip.Tip="Choisir les formats copiés et le profil de conversion" />
            <Button Content="Logs FFmpeg" Click="ShowLogsButton_Click" Padding="14,9" />

            <Button Content="Quitter"
              Click="QuitButton_Click"
              Padding="14,9"
              FontSize="13"
              FontWeight="Bold"
              Background="#222222"
              Foreground="White"
              ToolTip.Tip="Close the application" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── Content area: progress + stats + datagrid ── -->
    <Grid Grid.Row="3" Margin="16" RowDefinitions="Auto,Auto,Auto,*">
      <Border Grid.Row="0"
          Name="ProgressBorder"
          Padding="15"
          Background="#1f1f1f"
          Margin="0,0,0,10"
          IsVisible="False">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0"
                     Name="ProgressStatusText"
                     Text="Working..."
             Foreground="#CCCCCC"
                     FontWeight="Bold"
                     Margin="0,0,0,8" />

          <ProgressBar Grid.Row="1"
                       Name="ConversionProgressBar"
                       Height="22"
                       Value="0"
                       Maximum="100"
                       Margin="0,0,0,8" />

          <TextBlock Grid.Row="2"
                     Name="CurrentFileText"
                     Text=""
                     Foreground="#AAAAAA"
                     FontSize="12"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,8" />

          <Button Grid.Row="3"
                  Name="StopButton"
                  Content="Arrêter"
                  Click="StopButton_Click"
                  Padding="14,8"
                  HorizontalAlignment="Center"
                  Background="#C0392B"
                  Foreground="White"
                  FontWeight="Bold"
                  IsVisible="False"
                  ToolTip.Tip="Stop the current operation" />
        </Grid>
      </Border>

      <Border Grid.Row="1" Background="#0b6b3f" Padding="10,8" CornerRadius="5" Margin="0,0,0,10">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="40">
          <StackPanel>
            <TextBlock Text="Pistes source" Foreground="White" FontSize="11" HorizontalAlignment="Center" />
            <TextBlock Name="TotalFilesText" Text="0" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
          </StackPanel>

          <StackPanel>
            <TextBlock Text="MP3" Foreground="White" FontSize="11" HorizontalAlignment="Center" />
            <TextBlock Name="ImageCountText" Text="0" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
          </StackPanel>

          <StackPanel>
            <TextBlock Text="FLAC" Foreground="White" FontSize="11" HorizontalAlignment="Center" />
            <TextBlock Name="VideoCountText" Text="0" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
          </StackPanel>

          <StackPanel>
            <TextBlock Text="Taille source" Foreground="White" FontSize="11" HorizontalAlignment="Center" />
            <TextBlock Name="TotalSizeText" Text="0 MB" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Grid.Row="2" Name="ResultText" TextWrapping="Wrap" Foreground="#8FE0AC" Margin="0,0,0,10" FontWeight="SemiBold" />
      <dg:DataGrid Grid.Row="3"
                   x:Name="FilesDataGrid"
                   x:DataType="local:MediaFileInfo"
                   AutoGenerateColumns="False"
                   IsReadOnly="True"
                   HeadersVisibility="Column"
                   SelectionMode="Extended">
        <dg:DataGrid.Columns>
          <dg:DataGridTextColumn Header="Fichier" Binding="{Binding FileName}" Width="*" MinWidth="200" />
          <dg:DataGridTextColumn Header="Type" Binding="{Binding FileType}" Width="80" />
          <dg:DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="100" />
          <dg:DataGridTextColumn Header="Artiste" Binding="{Binding Artist}" Width="140" />
          <dg:DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="160" />
          <dg:DataGridTextColumn Header="Titre" Binding="{Binding Title}" Width="180" />
          <dg:DataGridTextColumn Header="État USB" Binding="{Binding CompareStatus}" Width="150" />
          <dg:DataGridTextColumn Header="Taille" Binding="{Binding FileSize}" Width="100" />
          <dg:DataGridTextColumn Header="Chemin source" Binding="{Binding FilePath}" Width="*" MinWidth="200" />
        </dg:DataGrid.Columns>
      </dg:DataGrid>
    </Grid>

    <!-- ── Status bar ── -->
    <Border Grid.Row="4" Background="#34495E" Padding="10">
      <TextBlock Name="StatusText"
                 Text="Choisissez les deux dossiers, puis cliquez sur Analyser. MusicBrainz sera intégré dans une phase future."
                 Foreground="White"
                 FontSize="12" />
    </Border>
  </Grid>
</Window>
