<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
        xmlns:local="clr-namespace:MediaFileAnalyzer"
        x:Class="MediaFileAnalyzer.MainWindow"
        Title="USB Music Prep"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ── Source row ── -->
    <Border Grid.Row="0" Padding="16,12" Background="#ECF0F1">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <TextBlock Grid.Column="0"
                   Text="Source:"
                   VerticalAlignment="Center"
                   FontWeight="Bold"
                   Margin="0,0,10,0" />

        <TextBox Grid.Column="1"
                 Name="FolderPathTextBox"
                 VerticalAlignment="Center"
                 Padding="8"
                 FontSize="14"
                 Background="White"
                 Foreground="#1F2933"
                 BorderBrush="#95A5A6"
                 PlaceholderText="Type or paste folder path here..." />

        <Button Grid.Column="2"
                Content="Browse..."
                Click="BrowseButton_Click"
                Padding="15,8"
                Margin="10,0,0,0"
                FontSize="14"
                Background="#3498DB"
                Foreground="White"
                ToolTip.Tip="Select source music folder" />

        <Button Grid.Column="3"
                Content="Scan"
                Click="ScanButton_Click"
                Padding="15,8"
                Margin="10,0,0,0"
                FontSize="14"
                FontWeight="Bold"
                Background="#27AE60"
                Foreground="White"
                ToolTip.Tip="Scan selected source folder for audio files" />
      </Grid>
    </Border>

    <!-- ── Target row ── -->
    <Border Grid.Row="1" Padding="16,12" Background="#DCE8EE">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">
        <TextBlock Grid.Column="0"
                   Text="Target:"
                   VerticalAlignment="Center"
                   FontWeight="Bold"
                   Margin="0,0,10,0" />

        <TextBox Grid.Column="1"
                 Name="TargetFolderPathTextBox"
                 VerticalAlignment="Center"
                 Padding="8"
                 FontSize="14"
                 IsReadOnly="True"
                 Background="White"
                 Foreground="#1F2933"
                 BorderBrush="#95A5A6"
                 PlaceholderText="Select target folder (USB drive)..." />

        <Button Grid.Column="2"
                Content="Browse..."
                Click="BrowseTargetButton_Click"
                Padding="15,8"
                Margin="10,0,0,0"
                FontSize="14"
                Background="#2980B9"
                Foreground="White"
                ToolTip.Tip="Select target USB drive folder" />

        <Button Grid.Column="3"
                Name="CompareButton"
                Content="Compare"
                Click="CompareButton_Click"
                Padding="15,8"
                Margin="10,0,0,0"
                FontSize="14"
                FontWeight="Bold"
                Background="#16A085"
                Foreground="White"
                IsEnabled="False"
                ToolTip.Tip="Match source tracks against target by metadata" />

        <Button Grid.Column="4"
                Name="ReorganizeTargetButton"
                Content="Reorganize"
                Click="ReorganizeButton_Click"
                Padding="12,8"
                Margin="20,0,0,0"
                FontSize="13"
                Background="#8E44AD"
                Foreground="White"
                ToolTip.Tip="Rename and sort audio files on the target into Artist/Album/Track layout" />

        <Button Grid.Column="5"
                Name="CleanTargetDuplicatesButton"
                Content="Clean Dups"
                Click="CleanTargetDuplicatesButton_Click"
                Padding="12,8"
                Margin="8,0,0,0"
                FontSize="13"
                Background="#C0392B"
                Foreground="White"
                ToolTip.Tip="Remove duplicate tracks from the target folder" />

        <Button Grid.Column="6"
          Name="RepairTargetButton"
          Content="Repair USB"
          Click="RepairTargetButton_Click"
          Padding="12,8"
          Margin="8,0,0,0"
          FontSize="13"
          Background="#D68910"
          Foreground="White"
          ToolTip.Tip="Inspect the target USB drive and fix song ordering/layout issues without emptying it" />
      </Grid>
    </Border>

    <!-- ── Actions toolbar ── -->
    <Border Grid.Row="2" Padding="16,10" Background="#ECF0F1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Name="ConvertButton"
                  Content="Convert FLAC to MP3 (320kbps)"
                  Click="ConvertButton_Click"
                  Padding="14,9"
                  FontSize="13"
                  FontWeight="Bold"
                  Background="#E74C3C"
                  Foreground="White"
                  IsEnabled="False"
                  ToolTip.Tip="Convert FLAC files to the configured output format" />

            <!-- Rename (Picard) removed -->

          <Button Name="TransferButton"
                  Content="Transfer to Target"
                  Click="TransferButton_Click"
                  Padding="14,9"
                  FontSize="13"
                  FontWeight="Bold"
                  Background="#1F7A8C"
                  Foreground="White"
                  IsEnabled="False"
                  ToolTip.Tip="Copy or transcode missing tracks to the target" />

            <Button Name="PrepareUsbButton"
              Content="One-Step Prepare USB"
              Click="PrepareUsbButton_Click"
              Padding="14,9"
              FontSize="13"
              FontWeight="Bold"
              Background="#6C5CE7"
              Foreground="White"
              IsEnabled="False"
              ToolTip.Tip="Compare, optionally open Picard for tag fixes, then transfer everything in one guided flow" />



          <CheckBox Name="CompilationCheckBox"
                    IsVisible="False"
                    IsChecked="True"
                    VerticalAlignment="Center"
                    ToolTip.Tip="When checked, albums with multiple artists are grouped under a 'Various Artists' folder">
            <TextBlock Text="Group multi-artist albums under 'Various Artists'"
                       Foreground="#333"
                       FontStyle="Italic" />
          </CheckBox>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Name="ProgressCountText"
                     Text=""
                     VerticalAlignment="Center"
                     Foreground="#333"
                     FontWeight="Bold"
                     Margin="0,0,8,0" />

          <Button Name="SettingsButton"
                  Content="⚙ Settings"
                  Click="SettingsButton_Click"
                  Padding="14,9"
                  FontSize="13"
                  FontWeight="Bold"
                  Background="#34495E"
                  Foreground="White"
                  ToolTip.Tip="Configure which formats to keep and the output codec/bitrate" />

          <Button Content="Quit"
                  Click="QuitButton_Click"
                  Padding="14,9"
                  FontSize="13"
                  FontWeight="Bold"
                  Background="#2D3436"
                  Foreground="White"
                  ToolTip.Tip="Close the application" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── Content area: progress + stats + datagrid ── -->
    <Grid Grid.Row="3" Margin="16" RowDefinitions="Auto,Auto,*">
      <Border Grid.Row="0"
              Name="ProgressBorder"
              Padding="15"
              Background="#ECF0F1"
              Margin="0,0,0,10"
              IsVisible="False">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0"
                     Name="ProgressStatusText"
                     Text="Working..."
                     Foreground="#333"
                     FontWeight="Bold"
                     Margin="0,0,0,8" />

          <ProgressBar Grid.Row="1"
                       Name="ConversionProgressBar"
                       Height="22"
                       Value="0"
                       Maximum="100"
                       Margin="0,0,0,8" />

          <TextBlock Grid.Row="2"
                     Name="CurrentFileText"
                     Text=""
                     Foreground="#555"
                     FontSize="12"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,8" />

          <Button Grid.Row="3"
                  Name="StopButton"
                  Content="Stop"
                  Click="StopButton_Click"
                  Padding="14,8"
                  HorizontalAlignment="Center"
                  Background="#C0392B"
                  Foreground="White"
                  FontWeight="Bold"
                  IsVisible="False"
                  ToolTip.Tip="Stop the current operation" />
        </Grid>
      </Border>

      <Border Grid.Row="1" Background="#3498DB" Padding="10,8" CornerRadius="5" Margin="0,0,0,10">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="40">
          <StackPanel>
            <TextBlock Text="Total Files" Foreground="White" FontSize="11" HorizontalAlignment="Center" />
            <TextBlock Name="TotalFilesText" Text="0" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
          </StackPanel>

          <StackPanel>
            <TextBlock Text="MP3 Files" Foreground="White" FontSize="11" HorizontalAlignment="Center" />
            <TextBlock Name="ImageCountText" Text="0" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
          </StackPanel>

          <StackPanel>
            <TextBlock Text="FLAC Files" Foreground="White" FontSize="11" HorizontalAlignment="Center" />
            <TextBlock Name="VideoCountText" Text="0" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
          </StackPanel>

          <StackPanel>
            <TextBlock Text="Total Size" Foreground="White" FontSize="11" HorizontalAlignment="Center" />
            <TextBlock Name="TotalSizeText" Text="0 MB" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>

      <dg:DataGrid Grid.Row="2"
                   x:Name="FilesDataGrid"
                   x:DataType="local:MediaFileInfo"
                   AutoGenerateColumns="False"
                   IsReadOnly="True"
                   HeadersVisibility="Column"
                   SelectionMode="Extended">
        <dg:DataGrid.Columns>
          <dg:DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="*" MinWidth="200" />
          <dg:DataGridTextColumn Header="Type" Binding="{Binding FileType}" Width="80" />
          <dg:DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="100" />
          <dg:DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="140" />
          <dg:DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="160" />
          <dg:DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="180" />
          <dg:DataGridTextColumn Header="Compare" Binding="{Binding CompareStatus}" Width="120" />
          <dg:DataGridTextColumn Header="Size" Binding="{Binding FileSize}" Width="100" />
          <dg:DataGridTextColumn Header="Path" Binding="{Binding FilePath}" Width="*" MinWidth="200" />
        </dg:DataGrid.Columns>
      </dg:DataGrid>
    </Grid>

    <!-- ── Status bar ── -->
    <Border Grid.Row="4" Background="#34495E" Padding="10">
      <TextBlock Name="StatusText"
                 Text="Ready. Select a source folder and click Scan to begin."
                 Foreground="White"
                 FontSize="12" />
    </Border>
  </Grid>
</Window>
